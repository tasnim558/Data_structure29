#include <iostream>
using namespace std;

struct Node
{
    int data;
    Node *next;
};

// Check if Stack is Empty
bool isEmpty(Node *top)
{
    return (top == NULL);
}

// Push Operation
Node *push(Node *top, int value)
{
    Node *newNode = new Node();

    newNode->data = value;
    newNode->next = top;
    top = newNode;

    return top;
}

// Display Operation
void display(Node *top)
{
    if (isEmpty(top))
    {
        cout << "Stack is Empty." << endl;
        return;
    }

    Node *temp = top;

    while (temp != NULL)
    {
        cout << temp->data << " -> ";
        temp = temp->next;
    }

    cout << "NULL" << endl;
}

int main()
{
    Node *stack = NULL;

    int n, value;

    cout << "How many elements do you want to push? ";
    cin >> n;

    for (int i = 0; i < n; i++)
    {
        cout << "Enter element " << i + 1 << ": ";
        cin >> value;

        stack = push(stack, value);
    }

    cout << "\nAfter Push:" << endl;
    display(stack);

    cout << "Stack Empty: " << (isEmpty(stack) ? "True" : "False") << endl;

    return 0;
}
