#include <iostream>
using namespace std;

struct Node {
    int data;
    Node* next;
};

Node* arrayToList(int arr[], int n) {
    Node *head = NULL, *temp = NULL, *newNode;

    for (int i = 0; i < n; i++) {

        newNode = new Node();
        newNode->data = arr[i];
        newNode->next = NULL;

        if (head == NULL) {
            head = newNode;
            temp = newNode;
        } else {
            temp->next = newNode;
            temp = newNode;
        }
    }

    return head;
}

void printList(Node* head) {
    Node* temp = head;

    while (temp != NULL) {
        cout << temp->data << " -> ";
        temp = temp->next;
    }
    cout << "NULL" << endl;
}

int main() {
    int arr[] = {10, 20, 30, 40};
    int n = 4;

    Node* head = arrayToList(arr, n);

    printList(head);

    return 0;
}
