#include <iostream>
using namespace std;

int MAXSIZE = 8;
int stack[8];
int top = -1;

// Check if Stack is Full
int isfull()
{
    if (top == MAXSIZE - 1)
        return 1;
    else
        return 0;
}

// Check if Stack is Empty
int isempty()
{
    if (top == -1)
        return 1;
    else
        return 0;
}

// Push Operation
void push(int data)
{
    if (!isfull())
    {
        top = top + 1;
        stack[top] = data;
    }
    else
    {
        cout << "Stack is Full." << endl;
    }
}

// Pop Operation
int pop()
{
    if (!isempty())
    {
        int data = stack[top];
        top = top - 1;
        return data;
    }
    else
    {
        cout << "Stack is Empty." << endl;
        return -1;
    }
}

// Display Operation
void display()
{
    if (isempty())
    {
        cout << "Stack is Empty." << endl;
        return;
    }

    cout << "Stack Elements: ";
    for (int i = 0; i <= top; i++)
    {
        cout << stack[i] << " ";
    }
    cout << endl;
}

int main()
{
    int n, value;

    cout << "How many elements do you want to push? ";
    cin >> n;

    // Push
    for (int i = 0; i < n; i++)
    {
        cout << "Enter element " << i + 1 << ": ";
        cin >> value;
        push(value);
    }

    cout << "\nAfter Push:" << endl;
    display();

    // Pop
    cout << "\nDeleted Element: " << pop() << endl;

    cout << "\nAfter Pop:" << endl;
    display();

    return 0;
}
