#include <iostream>
using namespace std;

struct Node {
    int data;
    Node* next;
};

// Create linked list from array
Node* createList(int arr[], int n) {
    Node *head = NULL, *temp = NULL, *newNode;

    for (int i = 0; i < n; i++) {
        newNode = new Node();
        newNode->data = arr[i];
        newNode->next = NULL;

        if (head == NULL) {
            head = newNode;
            temp = newNode;
        } else {
            temp->next = newNode;
            temp = newNode;
        }
    }
    return head;
}

// Insert at any position
Node* insertAtPosition(Node* head, int val, int pos) {
    Node* newNode = new Node();
    newNode->data = val;
    newNode->next = NULL;

    // Insert at beginning
    if (pos == 1) {
        newNode->next = head;
        return newNode;
    }

    Node* temp = head;

    // Move to (pos-1)
    for (int i = 1; i < pos - 1 && temp != NULL; i++) {
        temp = temp->next;
    }

    // Invalid position
    if (temp == NULL) {
        cout << "Invalid position!" << endl;
        return head;
    }

    // Insert
    newNode->next = temp->next;
    temp->next = newNode;

    return head;
}

// Print list
void printList(Node* head) {
    Node* temp = head;

    while (temp != NULL) {
        cout << temp->data << " -> ";
        temp = temp->next;
    }

    cout << "NULL" << endl;
}

// Main function
int main() {
    int arr[] = {10, 20, 30};
    int n = 3;

    Node* head = createList(arr, n);

    cout << "Before insertion: ";
    printList(head);

    // Insert 25 at position 3
    head = insertAtPosition(head, 25, 3);

    cout << "After insertion: ";
    printList(head);

    return 0;
}
